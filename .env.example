# IntentPay AI environment example
# Copy this file to .env for local development.

# Persistence backend:
# - sqlite: default local runtime database
# - postgres: PostgreSQL adapter
PERSISTENCE_BACKEND=sqlite

# Required only when PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://intentpay:intentpay@localhost:5432/intentpay

# Reset local database on startup:
# - 0: keep persisted data
# - 1: reset database
RESET_DB=0

# Optional LLM intent parser:
# - Leave OPENAI_API_KEY empty to use deterministic rule parser.
# - Set OPENAI_API_KEY locally in .env to enable LLM Parser in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
